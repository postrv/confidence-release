{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "confidence-evaluator",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "traces": {"enabled": true, "head_sampling_rate": 0.1, "persist": true}, "redact_query_string": true, "logs": {"enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true}},
  "durable_objects": { "bindings": [
    { "name": "EVALUATIONS", "class_name": "EvaluationSandbox" },
    { "name": "FIXTURES", "class_name": "FixtureStore" },
    { "name": "SCHEDULER", "class_name": "EvaluationScheduler" }
  ] },
  "exports": {
    "EvaluationSandbox": { "type": "durable-object", "storage": "sqlite", "container": "confidence-checker" },
    "FixtureStore": { "type": "durable-object", "storage": "sqlite" },
    "EvaluationScheduler": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [{ "name": "confidence-checker", "class_name": "EvaluationSandbox", "scheduling_policy": "durable_object", "images": { "base": { "dockerfile": "Dockerfile", "build_context": "../.." } } }],
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "confidence-objects" }],
  "services": [{ "binding": "AUTHORITY", "service": "confidence-authority" }],
  "vars": { "CHECKER_KEY_ID": "checker-v1", "EVALUATION_IMAGE_DIGEST": "UNCONFIGURED", "CHECKER_IMPLEMENTATION_DIGEST": "UNCONFIGURED" },
  "secrets": { "required": ["EVALUATOR_SERVICE_TOKEN", "CHECKER_SIGNING_KEY"] },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
