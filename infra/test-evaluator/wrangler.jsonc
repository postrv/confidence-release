{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "confidence-evaluator-test-only-never-deploy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [
    { "name": "SCHEDULER", "class_name": "TestScheduler" },
    { "name": "EVALUATIONS", "class_name": "FakeEvaluation" },
    { "name": "TEST_EVALUATIONS", "class_name": "TestEvaluationSandbox" },
    { "name": "FIXTURES", "class_name": "FixtureStore" },
    { "name": "CALLBACKS", "class_name": "TestCallbackReceiver" }
  ] },
  "exports": {
    "TestScheduler": { "type": "durable-object", "storage": "sqlite" },
    "FakeEvaluation": { "type": "durable-object", "storage": "sqlite" },
    "TestEvaluationSandbox": { "type": "durable-object", "storage": "sqlite" },
    "FixtureStore": { "type": "durable-object", "storage": "sqlite" },
    "TestCallbackReceiver": { "type": "durable-object", "storage": "sqlite" }
  },
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "owned-evaluator-test-objects" }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
