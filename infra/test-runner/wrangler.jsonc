{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "confidence-runner-test-only-never-deploy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ATTEMPTS", "class_name": "OwnedRunner" }, { "name": "CALLBACKS", "class_name": "OwnedCallbacks" }] },
  "exports": { "OwnedRunner": { "type": "durable-object", "storage": "sqlite" }, "OwnedCallbacks": { "type": "durable-object", "storage": "sqlite" } },
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "owned-runner-test-objects" }],
  "services": [{ "binding": "AUTHORITY", "service": "confidence-runner-test-only-never-deploy" }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
