{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "confidence-live-container-package-only",
  "main": "worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "HARNESS", "class_name": "LiveContainerHarness" }] },
  "exports": { "LiveContainerHarness": { "type": "durable-object", "storage": "sqlite" } },
  "containers": [{ "name": "confidence-live-container-package-only-inert", "class_name": "LiveContainerHarness", "scheduling_policy": "durable_object", "images": { "inert": { "dockerfile": "./Dockerfile", "build_context": "./" } }, "observability": { "enabled": false } }],
  "vars": { "RUN_ID": "UNCONFIGURED", "RUN_EXPIRES_AT": "0" },
  "secrets": { "required": ["ADMIN_TOKEN"] }
}
