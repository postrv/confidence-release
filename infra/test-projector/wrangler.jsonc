{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "confidence-projector-test-only-never-deploy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "owned-test-projection",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECTS",
        "class_name": "ProjectionAuthority"
      }
    ]
  },
  "exports": {
    "ProjectionAuthority": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "owned-test-only-projection-objects"
    }
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ]
}
