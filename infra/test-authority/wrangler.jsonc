{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "confidence-authority-test-only-never-deploy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "PROJECTS", "class_name": "TestAuthority" }, { "name": "WAKE", "class_name": "WakeAuthority" }] },
  "exports": { "TestAuthority": { "type": "durable-object", "storage": "sqlite" }, "WakeAuthority": { "type": "durable-object", "storage": "sqlite" } },
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "owned-test-only-objects" }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
