{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "confidence-projects-test-only-never-deploy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "PROJECTS", "class_name": "TestProjectAuthority" }, { "name": "PROJECT_DIRECTORY", "class_name": "ProjectDirectory" }] },
  "exports": { "TestProjectAuthority": { "type": "durable-object", "storage": "sqlite" }, "ProjectDirectory": { "type": "durable-object", "storage": "sqlite" } },
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "owned-projects-test-only" }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
